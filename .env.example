# Copy this file to .env and fill only the keys you actually use.
# Never commit .env because it can contain private API keys.

# Backend
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional API keys
OPENDART_API_KEY=
FMP_API_KEY=
FRED_API_KEY=
TRADING_ECONOMICS_API_KEY=

# Toss Open API. Register this backend server's outbound IPv4 in Toss WTS first.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_TOKEN_URL=https://openapi.tossinvest.com/oauth2/token
TOSS_CANDLES_URL=https://openapi.tossinvest.com/api/v1/candles

# AI servers
# Server 1 receives stock/date/price data as JSON and returns base64 chart images.
AI_CHART_IMAGE_URL=https://kospi-data-api.onrender.com/v1/render
KOSPI_RENDER_API_KEY=
# Server 2 receives chart images as multipart/form-data file and returns pattern/confidence.
AI_PATTERN_SERVER_PREDICT_URL=https://stock-api-server-r63u.onrender.com/predict/
AI_PATTERN_SERVER_TIMEOUT_SECONDS=180
# Optional general AI summary server. It receives AiAnalysisRequest JSON and returns AiAnalysisResponse JSON.
AI_ANALYSIS_SERVER_URL=

# Keep mock disabled in normal runs.
AI_CHART_IMAGE_MOCK_ENABLED=false
AI_CHART_PATTERN_MOCK_ENABLED=false
AI_ANALYSIS_MOCK_ENABLED=false

# KOSPI nightly chart-pattern batch
CHART_PATTERN_BATCH_ENABLED=false
CHART_PATTERN_BATCH_CRON=0 0 22 * * MON-FRI
CHART_PATTERN_BATCH_DELAY_MS=1000

# KOSPI OHLC pre-collection batch
CANDLE_SYNC_ENABLED=false
CANDLE_SYNC_CRON=0 30 21 * * MON-FRI
CANDLE_SYNC_DELAY_MS=500

# Market event refresh
MARKET_EVENTS_LOOK_AHEAD_DAYS=60
MARKET_EVENTS_REFRESH_MS=21600000

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api
